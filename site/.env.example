# TekJobs site. Copy to .env.local. Every block is optional: without its keys that part of the site stays off
# and the landing page and docs work as a static site.

# App
NEXT_PUBLIC_APP_URL=https://tekjobs.timurtek.com
# "1" puts job posting on sale. Off, the pricing page says "soon" and /api/checkout answers 503.
NEXT_PUBLIC_PURCHASES_OPEN=0
# Signs the session cookie's fallback HMAC. Any long random string; rotate to sign everyone out.
SESSION_SECRET=

# Firebase, client (public). Auth turns on when the first three exist.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: point the client at the local emulator, e.g. 127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# Firebase, server (Admin SDK). The service account JSON on one line (in a .env file wrap it in single quotes; in
# Vercel paste it bare; base64 of the file also works), or leave empty to use application default credentials.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=

# Stripe. Checkout Sessions are created over the REST API with the secret key; the webhook is verified with the signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The one product this site sells: a job posting. A Price id (price_...), one-time.
STRIPE_PRICE_JOB_POSTING=
