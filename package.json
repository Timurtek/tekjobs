{
  "name": "@timurtekb/tekjobs",
  "version": "0.29.0",
  "description": "A local-first job-search machine: watches hundreds of company job boards, scores every posting against your profile, and files matches into a folder of markdown notes you own. Bring your own LLM through MCP.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tekjobs": "cli.mjs"
  },
  "scripts": {
    "prepare": "husky || true",
    "release": "semantic-release",
    "test": "node --test \"test/**/*.test.mjs\"",
    "init": "node cli.mjs init",
    "status": "node cli.mjs status",
    "scan": "node run.mjs",
    "dry": "node run.mjs --dry",
    "check": "node run.mjs --dry --check-slugs",
    "serve": "node app/server/index.mjs",
    "mcp": "node app/server/mcp.mjs",
    "sample": "node tools/make-sample-vault.mjs",
    "counts": "node tools/counts.mjs"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.2.0",
    "husky": "^9.1.7",
    "semantic-release": "^24.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timurtek/tekjobs.git"
  },
  "homepage": "https://tekjobs.timurtek.com",
  "bugs": {
    "url": "https://github.com/Timurtek/tekjobs/issues"
  },
  "keywords": [
    "job-search",
    "local-first",
    "markdown",
    "obsidian",
    "mcp",
    "scraper",
    "greenhouse",
    "lever",
    "ashby"
  ],
  "files": [
    "cli.mjs",
    "run.mjs",
    "run.cmd",
    "run.sh",
    "scraper/",
    "app/server/",
    "app/dist/",
    "samples/vault/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "semantic-release": {
      "@semantic-release/npm": "$@semantic-release/npm"
    }
  }
}
