# Copy to .env (gitignored) and fill in. Never commit .env: it holds keys.

# Tailscale admin console → Settings → Keys → Generate auth key (reusable: off, ephemeral: off).
# Only needed for the first start; the node's state is kept in a volume after that.
TS_AUTHKEY=tskey-auth-REPLACE-ME

# The Tailscale login(s) allowed in, comma-separated. Everyone else gets a 403.
TEKJOBS_ALLOWED_LOGINS=you@example.com

# The folder on this machine that holds your profile (job notes, criteria, logs). It is mounted at /vault.
# Point an Obsidian vault's folder here, or a folder that Syncthing or Obsidian Sync keeps in step with your laptop.
TEKJOBS_PROFILE_DIR=/srv/tekjobs/profile

# The owner of that folder (`id -u`, `id -g`), so the notes TekJobs writes stay yours.
PUID=1000
PGID=1000

# Your time zone: the daily run and every date written into a note use it.
TZ=America/Los_Angeles

# The daily run: HH:MM or "off", and what it does (scan, mail, calendar). Add mail and calendar only once the
# Claude CLI below is signed in.
TEKJOBS_SCAN_TIME=07:30
TEKJOBS_DAILY=scan

# Optional, for cover letters, tailored resumes, mail and calendar: one of these signs the Claude CLI in.
# `claude setup-token` on a machine where you are signed in prints a long-lived token for your subscription.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Pin a release (0.60.0) instead of following the newest.
TEKJOBS_VERSION=latest
