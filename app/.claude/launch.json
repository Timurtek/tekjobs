{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tekjobs-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.mjs"
      ],
      "port": 8787
    },
    {
      "name": "tekjobs-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "tekjobs-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "../site",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000
    }
  ]
}
